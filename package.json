{
  "name": "style-club",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "security:check": "node scripts/security-check.mjs",
    "security:check:dist": "node scripts/security-check.mjs --dist",
    "security:verify": "npm run security:check && npm audit --audit-level=high && npm run typecheck && npm run build && npm run security:check:dist",
    "release:check": "node scripts/release-check.mjs",
    "release:check:dist": "node scripts/release-check.mjs --dist",
    "release:check:live": "node scripts/release-check.mjs --live",
    "release:verify": "npm run security:verify && npm run release:check && npm run release:check:dist"
  },
  "dependencies": {
    "framer-motion": "^13.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
